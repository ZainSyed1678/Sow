# ==========================================
# AI/ML Notion Researcher - Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.
# ==========================================

# --- Groq LLM API Settings ---
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Override the default model if desired (default: llama-3.3-70b-versatile)
# Supported options include: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# --- Notion API Settings ---
# Create an internal integration token at: https://www.notion.so/my-integrations
# Make sure to give it "Read content", "Update content", and "Insert content" capabilities.
NOTION_API_KEY=ntn_your_notion_integration_token_here

# Notion Database IDs (32-character hexadecimal strings from your database URLs)
# Remember to share each of these 5 databases with your Notion integration!
NOTION_DATABASE_ID_DAILY_BRIEFINGS=your_daily_briefings_database_id_here
NOTION_DATABASE_ID_CONCEPT_LIBRARY=your_concept_library_database_id_here
NOTION_DATABASE_ID_RESEARCH_PAPERS=your_research_papers_database_id_here
NOTION_DATABASE_ID_TOOLS_FRAMEWORKS=your_tools_frameworks_database_id_here
NOTION_DATABASE_ID_WEEKLY_REVIEWS=your_weekly_reviews_database_id_here

# --- Optional GitHub Token ---
# For higher rate limits when querying GitHub API (60 req/hr unauthenticated vs 5000 req/hr authenticated)
GITHUB_TOKEN=your_optional_github_personal_access_token_here

# --- Execution Runtime Settings ---
# Set to 'true' to test collection, ranking, and generation without publishing to Notion
DRY_RUN=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Storage path for local SQLite state (for local runs)
SQLITE_DB_PATH=local_state/researcher.db
